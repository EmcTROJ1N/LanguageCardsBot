<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="github" value="https://nuget.pkg.github.com/EmcTROJ1N/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="github">
            <package pattern="LanguageCardsBot.Contracts.*" />
            <package pattern="Contracts.Cards" />
            <package pattern="Contracts.Common" />
            <package pattern="Contracts.Passport" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
