<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>LanguageCardsBot.Contracts.Messaging</PackageId>
    <Version>1.1.0</Version>
    <Authors>EmcTROJ1N team</Authors>
    <Description>Shared RabbitMQ event contracts for LanguageCardsBot services</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>LanguageCardsBot.Contracts.Messaging</RootNamespace>
    <RepositoryUrl>https://github.com/EmcTROJ1N/LanguageCardsBot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Validators\" />
  </ItemGroup>
</Project>