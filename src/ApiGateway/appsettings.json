{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "Jaeger": {
      "Endpoint": "http://jaeger:4317"
    },
    "EnableConsoleExporter": false
  },
  "ReverseProxy": {
    "Routes": {
      "cards-api": {
        "ClusterId": "cards-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/cards/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/cards" }
        ]
      },
      "passport-api": {
        "ClusterId": "passport-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/passport/{**catch-all}"
        }
      },
      "web-ui": {
        "ClusterId": "web-ui-cluster",
        "Order": 100,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cards-cluster": {
        "Destinations": {
          "cards-destination": {
            "Address": "http://cards-presentation:8081"
          }
        }
      },
      "passport-cluster": {
        "Destinations": {
          "passport-destination": {
            "Address": "http://passport_presentation:8080"
          }
        }
      },
      "web-ui-cluster": {
        "Destinations": {
          "web-ui-destination": {
            "Address": "http://web-ui:80"
          }
        }
      }
    }
  }
}
