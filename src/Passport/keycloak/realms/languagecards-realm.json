{
  "realm": "languagecards",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 604800,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "User",
        "description": "Default realm role assigned to registered end-users."
      }
    ],
    "client": {
      "languagecards-backend": [
        {
          "name": "Admin",
          "description": "Administrative role on the languagecards-backend resource. Required by the AdminAndUser policy.",
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "languagecards-backend",
      "name": "LanguageCards Backend (confidential)",
      "description": "Confidential client used by Passport for the client_credentials grant against the Keycloak admin API.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "secret": "2ktfaj5K6bPkDLg2yKt4RI99Ct5owXnd",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "use.refresh.tokens": "false"
      }
    },
    {
      "clientId": "languagecardsbot-public",
      "name": "LanguageCardsBot Public",
      "description": "Public client used by the Telegram bot to obtain user tokens via the password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "languagecards-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "languagecards-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-languagecards-backend",
      "enabled": true,
      "serviceAccountClientId": "languagecards-backend",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users"]
      }
    }
  ]
}
