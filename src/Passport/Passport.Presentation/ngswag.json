{
  "runtime": "Net100",
  "documentGenerator": {
    "fromDocument": {
      "json": "$(PassportOpenApiSpec)",
      "output": null
    }
  },
  "codeGenerators": {
    "openApiToCSharpController": {
      "clientBaseClass": null,
      "controllerBaseClass": "ControllerBase",
      "controllerStyle": "Abstract",
      "controllerTarget": "AspNetCore",
      "namespace": "Passport.Presentation.Controllers.Generated",
      "className": "{controller}ControllerBase",
      "generateOptionalParameters": true,
      "useCancellationToken": true,
      "output": "Controllers/Generated/PassportControllers.generated.cs"
    }
  }
}
