<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="LanguageCardsBot.Contracts.Cards" Version="3.0.1" />
    <PackageReference Include="LanguageCardsBot.Contracts.Common" Version="1.0.0" />
    <PackageReference Include="Mapster" Version="10.0.6-a" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <LanguageCardsBotGrpcServices>Server</LanguageCardsBotGrpcServices>
  </PropertyGroup> 

  <ItemGroup>
    <Protobuf Include="../LanguageCardsBot.Contracts.Cards/Protos/**/*.proto"
              ProtoRoot="../LanguageCardsBot.Contracts.Cards/Protos"
              GrpcServices="$(LanguageCardsBotGrpcServices)"
              CompileOutputs="true" />
    <ProtoBuf Include="..\Contracts.Cards\Protos\cards_import_service.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Public</Access>
      <ProtoCompile>True</ProtoCompile>
      <ProtoRoot>../LanguageCardsBot.Contracts.Cards/Protos</ProtoRoot>
      <CompileOutputs>true</CompileOutputs>
      <OutputDir>obj\Debug/net8.0/</OutputDir>
      <Generator>MSBuild:Compile</Generator>
      <Link>Protos\cards_import_service.proto</Link>
    </ProtoBuf>
    <ProtoBuf Include="..\Contracts.Cards\Protos\card_service.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Public</Access>
      <ProtoCompile>True</ProtoCompile>
      <ProtoRoot>../LanguageCardsBot.Contracts.Cards/Protos</ProtoRoot>
      <CompileOutputs>true</CompileOutputs>
      <OutputDir>obj\Debug/net8.0/</OutputDir>
      <Generator>MSBuild:Compile</Generator>
      <Link>Protos\card_service.proto</Link>
    </ProtoBuf>
    <ProtoBuf Include="..\Contracts.Cards\Protos\common.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Public</Access>
      <ProtoCompile>True</ProtoCompile>
      <ProtoRoot>../LanguageCardsBot.Contracts.Cards/Protos</ProtoRoot>
      <CompileOutputs>true</CompileOutputs>
      <OutputDir>obj\Debug/net8.0/</OutputDir>
      <Generator>MSBuild:Compile</Generator>
      <Link>Protos\common.proto</Link>
    </ProtoBuf>
    <ProtoBuf Include="..\Contracts.Cards\Protos\stats_service.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Public</Access>
      <ProtoCompile>True</ProtoCompile>
      <ProtoRoot>../LanguageCardsBot.Contracts.Cards/Protos</ProtoRoot>
      <CompileOutputs>true</CompileOutputs>
      <OutputDir>obj\Debug/net8.0/</OutputDir>
      <Generator>MSBuild:Compile</Generator>
      <Link>Protos\stats_service.proto</Link>
    </ProtoBuf>
    <ProtoBuf Include="..\Contracts.Cards\Protos\translation_service.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Public</Access>
      <ProtoCompile>True</ProtoCompile>
      <ProtoRoot>../LanguageCardsBot.Contracts.Cards/Protos</ProtoRoot>
      <CompileOutputs>true</CompileOutputs>
      <OutputDir>obj\Debug/net8.0/</OutputDir>
      <Generator>MSBuild:Compile</Generator>
      <Link>Protos\translation_service.proto</Link>
    </ProtoBuf>
    <ProtoBuf Include="..\Contracts.Cards\Protos\user_service.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Public</Access>
      <ProtoCompile>True</ProtoCompile>
      <ProtoRoot>../LanguageCardsBot.Contracts.Cards/Protos</ProtoRoot>
      <CompileOutputs>true</CompileOutputs>
      <OutputDir>obj\Debug/net8.0/</OutputDir>
      <Generator>MSBuild:Compile</Generator>
      <Link>Protos\user_service.proto</Link>
    </ProtoBuf>
  </ItemGroup> 

  <ItemGroup>
    <ProjectReference Include="..\Cards.Application\Cards.Application.csproj" />
    <ProjectReference Include="..\Cards.Domain\Cards.Domain.csproj" />
    <ProjectReference Include="..\Cards.Infrastructure\Cards.Infrastructure.csproj" />
  </ItemGroup> 

  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

</Project>
